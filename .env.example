# --- Required ---------------------------------------------------------------
# Postgres connection string. The only variable needed to boot the app.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Settlement (server) -----------------------------------------------------
# Used by /api/settlements/confirm to read receipts back from chain.
EVM_RPC_URL=
SOLANA_RPC_URL=

# --- Verification ------------------------------------------------------------
# HMAC secret for POST /api/webhooks/github. Must match the secret configured
# on the GitHub webhook; without it the route returns 503.
GITHUB_WEBHOOK_SECRET=

# --- Auth email ----------------------------------------------------------------
# Sends verification, password reset, and invite email via Resend. Without it,
# src/lib/email.ts logs the message instead of sending it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Server-side origin for OAuth redirect_uri and email links. Defaults to the
# request's own origin — only needed if that's ever wrong (e.g. behind a proxy).
APP_URL=

# --- Settlement (browser) ----------------------------------------------------
# NEXT_PUBLIC_* values are inlined into the client bundle. Never put a secret here.
NEXT_PUBLIC_KEENETIX_CHAIN_ID=
NEXT_PUBLIC_KEENETIX_ESCROW_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_ESCROW_TOKEN_ACCOUNT=
NEXT_PUBLIC_SOLANA_USDC_MINT=

# --- SEO / analytics ---------------------------------------------------------
# Canonical origin used for metadataBase, canonical URLs, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://www.keenetix.xyz
# The authenticated app (sign-in through dashboard). Cross-host links from the
# marketing site — see src/proxy.ts, which enforces the split at runtime.
NEXT_PUBLIC_APP_URL=https://app.keenetix.xyz
# Ahrefs Web Analytics data-key. The script is only injected when this is set.
NEXT_PUBLIC_AHREFS_ANALYTICS_KEY=
# Ahrefs site-verification token, rendered as <meta name="ahrefs-site-verification">.
NEXT_PUBLIC_AHREFS_SITE_VERIFICATION=

# --- SDK / scripts -----------------------------------------------------------
# A scoped kntx_live_ key, only needed if you call the API from local scripts.
KEENETIX_API_KEY=
