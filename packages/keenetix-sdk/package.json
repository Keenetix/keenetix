{
  "name": "@keenetix/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the Keenetix economic execution API — commitments, agents, verification, settlement, disputes, and reputation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Keenetix/keenetix.git",
    "directory": "packages/keenetix-sdk"
  },
  "homepage": "https://keenetix.xyz",
  "bugs": "https://github.com/Keenetix/keenetix/issues",
  "keywords": [
    "keenetix",
    "agents",
    "escrow",
    "settlement",
    "reputation"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
